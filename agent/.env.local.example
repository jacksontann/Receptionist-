# LiveKit — same server the web app points at.
# LIVEKIT_URL is the ws:// endpoint the agent connects to.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# OpenAI — powers the LLM (gpt-4o-mini), STT and TTS.
OPENAI_API_KEY=

# Anam — the video avatar.
# NOTE: a Starter plan allows only ONE concurrent avatar session. If you also run
# TalentScreen's receptionist against the same key, only one of them can hold an
# avatar at a time; the other retries and then fails. Use a second Anam key here
# if you need both live simultaneously.
ANAM_RECEPTIONIST_API_KEY=
ANAM_RECEPTIONIST_AVATAR_ID=          # Carl  (male, 'ash' voice)
ANAM_RECEPTIONIST_AVATAR_ID_FEMALE=   # Cara  (female, 'coral' voice)
